{
  "name": "sandforge",
  "version": "1.8.0",
  "description": "SANDFORGE: BASTION WARS — Taktisches Wüsten-RTS mit territorialer Expansion",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run test:webgl-integration",
    "test:browser:classic": "npm run build:classic && npm --prefix tests/browser test",
    "test:reborn": "npm run build && node --test tests/reborn.test.mjs tests/reborn-campaign.test.mjs",
    "test:animation": "npm run build && node --test tests/reborn-animation.test.mjs tests/reborn-buildings.test.mjs tests/reborn-building-pbr.test.mjs tests/reborn-building-rigs.test.mjs",
    "assets:animations": "node scripts/render-unit-atlases.mjs",
    "assets:animations:hd": "node scripts/render-unit-atlases.mjs --hd",
    "assets:animation-audit": "npm run build && node scripts/audit-animation-assets.mjs",
    "assets:detailed-infantry": "node scripts/export-detailed-infantry.mjs",
    "assets:props": "node scripts/export-prop-pack.mjs",
    "assets:buildings": "node scripts/export-atlas-buildings.mjs",
    "assets:hq-construction": "node scripts/export-atlas-buildings.mjs --cpu --construction-only headquarters",
    "assets:buildings:validate": "node scripts/validate-building-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets:stylized": "node scripts/export-stylized-pack.mjs",
    "assets:stylized:check": "node scripts/export-stylized-pack.mjs --check && node scripts/validate-stylized-pack.mjs",
    "test:stylized": "npm run build && node --test tests/stylized-pack.test.mjs",
    "test:stylized:browser": "node scripts/verify-stylized-browser.mjs",
    "test:battlefields": "npm run build && node --test tests/sandforge-procedural-battlefields.test.mjs",
    "stress:battlefields": "npm run build && node scripts/stress-procedural-battlefields.mjs geometry",
    "test:performance": "npm run build && node scripts/benchmark-reborn-performance.mjs after",
    "test:ai-defense": "npm run build && node scripts/benchmark-ai-defense.mjs",
    "test:ai-director": "npm run build && node --test tests/reborn-ai-director.test.mjs tests/reborn-map-ai.test.mjs tests/reborn-control-retreat.test.mjs",
    "benchmark:ai": "npm run build && node scripts/benchmark-reborn-ai.mjs",
    "assets:transport": "node scripts/build-transport-helicopter.mjs && node scripts/render-unit-atlases.mjs --hd scout",
    "assets:rocket-launcher": "node scripts/build-rocket-launcher.mjs && node scripts/render-unit-atlases.mjs --hd artillery",
    "benchmark:arena": "npm run build && node scripts/ai-test-arena.mjs",
    "benchmark:arena:compare": "node scripts/ai-test-arena-compare.mjs",
    "deploy:uberspace": "node scripts/deploy-uberspace.mjs",
    "deploy:uberspace:dry-run": "node scripts/deploy-uberspace.mjs --dry-run",
    "deploy:uberspace:check": "node scripts/deploy-uberspace.mjs --check",
    "deploy:uberspace:rollback": "node scripts/deploy-uberspace.mjs --rollback",
    "test:webgl-integration": "npm run build && node --test tests/sandforge-spacious-desert.test.mjs tests/sandforge-bastion-navigation.test.mjs tests/reborn-combat-index.test.mjs tests/sandforge-webgl-entry.test.mjs && node scripts/test-webgl-integration.mjs",
    "build:3d": "SANDFORGE_RENDERER=webgl npm run build",
    "build:classic": "SANDFORGE_RENDERER=classic npm run build",
    "dev:3d": "SANDFORGE_RENDERER=webgl npm run dev",
    "dev:classic": "SANDFORGE_RENDERER=classic npm run dev",
    "test:building-design": "npm run build && node --test tests/webgl-building-design-system.test.mjs tests/webgl-barracks-hq3-door-exit-20261113.test.mjs tests/webgl-barracks-silhouette-20261113.test.mjs tests/webgl-funkzentrale-hq3-20261112.test.mjs tests/webgl-hq3-soldier-camo-construction-20261113.test.mjs tests/webgl-three-biome-camouflage-20261112.test.mjs tests/webgl-hq3-portal-and-yard-materials-20261113.test.mjs tests/webgl-hangar-factory-maintenance-20261110.test.mjs tests/webgl-faction-accents-20261108.test.mjs tests/webgl-strong-camo-thin-barbed-fences-20261112.test.mjs tests/webgl-authored-hq-barracks-construction-20261112.test.mjs tests/webgl-production-gates.test.mjs",
    "test:building-design:browser": "npm run build && node tests/browser/node_modules/playwright/cli.js test --config=tests/browser/playwright.config.mjs webgl-building-design-system.spec.mjs",
    "assets:building-reference": "node scripts/audit-building-design.mjs",
    "assets:building-reference:textures": "node scripts/audit-building-textures.mjs",
    "benchmark:building-design": "node scripts/benchmark-building-design.mjs"
  },
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "0.180.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
