{
  "name": "atlas-dominion",
  "version": "1.8.0",
  "description": "ATLAS DOMINION REBORN — Wüsten-RTS mit territorialer Expansion",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && npm --prefix tests/browser test",
    "test:reborn": "npm run build && node --test tests/reborn.test.mjs",
    "test:animation": "npm run build && node --test tests/reborn-animation.test.mjs",
    "assets:animations": "node scripts/render-unit-atlases.mjs",
    "assets:animation-audit": "node scripts/audit-animation-assets.mjs",
    "assets:detailed-infantry": "node scripts/export-detailed-infantry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ai-defense": "npm run build && node scripts/benchmark-ai-defense.mjs"
  },
  "devDependencies": {
    "three": "0.180.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
